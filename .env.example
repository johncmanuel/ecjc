API_URL=https://api.yourdomain.com

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=  # Run `npm run generate-secret` to generate one

# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# dotnet env vars use __ for nested configs

# PostgreSQL database connection string
ConnectionStrings__DefaultConnection="Host=localhost;Database=ecjc;Username=ecjc;Password=ecjc"

# Shared auth secret (must match BETTER_AUTH_SECRET above)
Auth__Secret=  # Same value as BETTER_AUTH_SECRET

# for optional broken streak penalties
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
Stripe__SecretKey=sk_test_...
Stripe__WebhookSecret=whsec_...

# Centrifugo (real-time notifications)
# The JWT token secret requirement is shared with BETTER_AUTH_SECRET 
CENTRIFUGO_HTTP_API_KEY=centrifugo-dev-api-key
CENTRIFUGO_ADMIN_PASSWORD=admin
CENTRIFUGO_ADMIN_SECRET=admin-secret
